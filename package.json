{
	"name": "revati_website",
	"version": "5.2.4",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm run licenses && vite build",
		"preview": "vite preview",
		"licenses": "node assets/scripts/collect-licenses.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"article": "node assets/scripts/create-article.ts"
	},
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.1",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@quantco/pnpm-licenses": "2.4.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-license": "^3.7.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5"
	},
	"type": "module",
	"dependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"@types/nprogress": "^0.2.3",
		"mdsvex": "^0.12.8",
		"nprogress": "^0.2.0",
		"sass": "^1.104.1",
		"svelte": "^5.57.1",
		"svelte-i18n": "^4.0.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"uuid": "^14.0.2",
		"vite": "^8.3.0"
	}
}
